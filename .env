# Copy this file to `.env` (same folder) and fill in your real key.
# `.env` itself is git-ignored — never commit it, and never paste a
# real key into a file that lives in the repo (including this one).

GEMINI_API_KEY=AQ.Ab8RN6I4YzIeuU-R4EwJFiBXgOM5lFBTfcH325odUWWdZnuQPg

# Optional overrides
PORT=5000
GEMINI_MODEL=gemini-2.5-flash

# Google Search grounding — lets Gemini search the live web when it
# decides a question needs current info, instead of only answering from
# training data. On by default. Set to false to disable (e.g. to control
# cost): Gemini 2.5 gives 1,500 grounded requests/day free then charges
# roughly $35 per 1,000 grounded prompts; Gemini 3.x models give 5,000/month
# free then ~$14 per 1,000. One message can trigger several search queries,
# each billed separately. See ai.google.dev/gemini-api/docs/pricing.
ENABLE_SEARCH_GROUNDING=true

# Once your frontend is deployed at a real URL (e.g. https://dipesh.dev),
# set this on your HOST's environment variable settings (Render/Railway/
# Fly.io dashboard etc.) — not in a file — to lock the API down to your
# own site only.
ALLOWED_ORIGIN=https://com-udiw.onrender.com
